### 환경 변수 설정
@host = localhost
@gatewayPort = 19000
@catalogPort = 19800
@orderPort = 19700

### 1. [Test] 내부 API용 테스트 JWT 토큰 발급
GET http://{{host}}:{{orderPort}}/test/internal-token?audience=catalog-service

> {%
    client.test("내부 토큰 획득 성공", function () {
        client.assert(response.status === 200, "내부 토큰 발급 실패");
        client.global.set("cat_internal_token", response.body);
        client.log("=======================================");
        client.log("[토큰 획득] X-Internal-Token 저장 완료");
        client.log("=======================================");
    });
%}

### 2. [Auth] 카탈로그 전용 유저 로그인 (조회용)
POST http://{{host}}:{{gatewayPort}}/api/v1/auth/login
Content-Type: application/json

{
    "loginId": "test95",
    "password": "test123!5"
}

> {%
    client.test("유저 로그인 검증", function () {
        client.assert(response.status === 200, "로그인 실패! 계정 생성을 확인하세요.");
        client.global.set("cat_user_token", response.body.data.accessToken);
    });
%}

### 3. [Auth] 카탈로그 전용 점주 로그인 (404 방지용 검증)
POST http://{{host}}:{{gatewayPort}}/api/v1/auth/login
Content-Type: application/json

{
    "loginId": "Owner01",
    "password": "password1!"
}

> {%
    client.test("오너 로그인 검증", function () {
        client.assert(response.status === 200, "로그인 실패! 계정 생성을 확인하세요.");
        client.global.set("cat_owner_token", response.body.data.accessToken);
    });
%}

### 4. [Public] 상품 전체 조회 (목록)
GET http://{{host}}:{{gatewayPort}}/api/v1/products?page=0&size=10
Accept: application/json
Authorization: Bearer {{cat_user_token}}

> {%
    client.test("전체 조회 성공", function () {
        client.assert(response.status === 200, "조회 실패");
        client.assert(response.body.content !== undefined, "데이터가 없습니다.");
    });
%}

### 5. [Public] 상품 상세 조회 (단건)
GET http://{{host}}:{{gatewayPort}}/api/v1/products/{{inv_shared_product_id}}
Accept: application/json
Authorization: Bearer {{cat_owner_token}}

> {%
    client.test("상세 조회 및 카프카 데이터 동기화 확인", function () {
        client.assert(response.status === 200, "상세 조회 실패");
        client.assert(response.body.data.productId === client.global.get("inv_shared_product_id"), "ID 불일치(동기화 실패)");
        client.log("상품 단건 상세 조회 성공!");
    });
%}

### 0. Internal API 호출 전 토큰 갱신
GET http://{{host}}:{{orderPort}}/test/internal-token?audience=catalog-service

> {%
    client.global.set("cat_internal_token", response.body);
%}

### 6. [Internal] 옵션 검증 단건 유효성 및 가격 검증 API
GET http://{{host}}:{{catalogPort}}/internal/options/{{inv_shared_option_id}}/validate
Accept: application/json
X-Internal-Token: {{cat_internal_token}}

> {%
    client.test("옵션 검증 및 가격 합산 로직 확인", function () {
        client.assert(response.status === 200, "옵션 검증 API 호출 실패");
        // basePrice와 addPrice가 합산된 totalPrice가 200,000인지 확인
        client.assert(response.body.data.totalPrice === 200000, "가격 합산 오류: " + response.body.data.totalPrice);
        client.log("최종 계산된 결제 가격: " + response.body.data.totalPrice);
    });
%}

### 7. [검증] 기간 만료 상품 상태(EXPIRED) 동기화 확인
GET http://{{host}}:{{gatewayPort}}/api/v1/products/all?page=0&size=50
Accept: application/json
Authorization: Bearer {{cat_owner_token}}

> {%
    client.test("Phase 1: 전시 상태 EXPIRED 변경 완벽 확인", function () {
        var content = response.body.data ? response.body.data.content : response.body.content;
        var targetId = client.global.get("inv_expired_product_id");
        var product = content.find(p => p.productId === targetId || p.id === targetId);

        client.assert(product !== undefined, "상품 목록에서 찾을 수 없습니다.");
        client.assert(product.status === "EXPIRED" || product.status === "HIDDEN", "동기화 실패. 현재 상태: " + product.status);
        client.assert(product.isVisible === false, "비활성 상품은 isVisible이 false여야 함");
        client.log("기간 만료 상태 카프카 동기화 확인 완료: " + product.status);
    });
%}

### 8. [Public] 정상 상품 단건 조회 (일일 재고 리셋 스케줄러 동기화 검증)
GET http://{{host}}:{{gatewayPort}}/api/v1/products/{{inv_shared_product_id}}
Accept: application/json
Authorization: Bearer {{cat_user_token}}

> {%
    client.test("카탈로그 스케줄러 동기화: 일일 재고 리셋 확인", function () {
        client.assert(response.status === 200, "조회 실패");
        client.assert(response.body && response.body.data, "응답 데이터가 없습니다.");
        client.assert(response.body.data.options && response.body.data.options.length > 0, "옵션 데이터가 누락되었습니다.");

        var option = response.body.data.options[0];
        client.assert(option.currentDailyStock === 20, "재고가 20이어야 하는데 현재 " + option.currentDailyStock);
        client.log("재고 리셋 동기화 완료: 현재 일일 재고 " + option.currentDailyStock);
    });
%}

### 9. [검증] 수정 및 삭제(Soft Delete) 동기화 검증
GET http://{{host}}:{{gatewayPort}}/api/v1/products/all?page=0&size=50
Accept: application/json
Authorization: Bearer {{cat_owner_token}}

> {%
    client.test("카탈로그 동기화: 상품 정보 수정 및 삭제 확인", function () {
        var content = response.body.data ? response.body.data.content : response.body.content;
        var targetId = client.global.get("inv_shared_product_id");
        var data = content.find(p => p.productId === targetId || p.id === targetId);

        client.assert(data !== undefined, "상품 목록에서 찾을 수 없습니다.");
        client.assert(data.name === "수정된 미슐랭 코스", "이름 수정 동기화 실패. 현재: " + data.name);
        client.assert(data.category === "EVENT", "카테고리 수정 동기화 실패. 현재: " + data.category);
        client.assert(data.basePrice === 99000, "가격 수정 동기화 실패. 현재: " + data.basePrice);
        client.assert(data.status === "DELETED", "상태가 DELETED로 동기화되지 않음. 현재: " + data.status);
        client.assert(data.isVisible === false, "DELETED 상품은 isVisible이 false여야 함");
        client.log("상품 정보 수정(updated) 및 삭제(status-changed) 카프카 동기화 완벽 성공!");
    });
%}

### 10. [검증] 품절(SOLDOUT) 자동 전이 동기화 검증
GET http://{{host}}:{{gatewayPort}}/api/v1/products/all?page=0&size=50
Accept: application/json
Authorization: Bearer {{cat_owner_token}}

> {%
    client.test("카탈로그 동기화: SOLDOUT 상태 전이 확인", function () {
        var content = response.body.data ? response.body.data.content : response.body.content;
        var targetId = client.global.get("inv_depletion_product_id");
        var data = content.find(p => p.productId === targetId || p.id === targetId);

        client.assert(data !== undefined, "상품 목록에서 찾을 수 없습니다.");
        var option = data.options[0];

        client.assert(option.totalQuantity === 0, "총 재고가 0이 아님: " + option.totalQuantity);
        client.assert(data.status === "SOLDOUT", "상태가 SOLDOUT으로 동기화되지 않음. 현재: " + data.status);
        client.assert(data.isVisible === false, "SOLDOUT 상품은 isVisible이 false여야 함");
        client.log("재고 소진 시 SOLDOUT 자동 전이 및 카프카 동기화 성공!");
    });
%}

### 11. 상품 전체 조회 (점주용 - 모든 상태 포함)
GET http://{{host}}:{{gatewayPort}}/api/v1/products/all?page=0&size=10
Accept: application/json
Authorization: Bearer {{cat_owner_token}}

> {%
    client.test("점주용 전체 상품 조회 성공", function () {
        client.assert(response.status === 200, "조회 실패");
        client.assert(
            response.body.content.some(function (item) {
                return item.status === "HIDDEN" || item.status === "SOLDOUT" || item.status === "DELETED" || item.status === "EXPIRED" || item.isVisible === false;
            }),
            "점주용 전체 조회에는 비활성 상태의 상품이 최소 1개 이상 포함되어야 합니다."
        );
        client.log("점주용 전체 상품 조회 검증 완료!");
    });
%}

### 002 [Cache-Aside Miss & Hit 유도] 메인 카탈로그 화면 다건 조회 연쇄 전송
# 최초 호출 시: 몽고DB 조회 연산 발생 (서버 콘솔에 "[Cache Miss] ..." 로그 출력 확인)
# 직후 재호출 시: Redis 인메모리 스냅샷 적중하여 속도가 1~2ms로 급감하며 콘솔 로그가 침묵함
GET http://{{host}}:{{gatewayPort}}/api/v1/products?page=1&size=10
Accept: application/json
Authorization: Bearer {{cat_user_token}}

> {%
    client.test("메인 화면 노출 및 Cache-Aside 적재 성공 확인", function () {
        client.assert(response.status === 200, "카탈로그 대량 조회 실패");

        // 데이터 전송 규격 매칭 (content 배열 직접 파싱)
        var content = response.body.content;
        client.assert(content !== undefined && content.length > 0, "도큐먼트 데이터셋이 비어있음.");

        var targetProduct = content.find(p => p.name === "타겟 부하테스트 상품");
        client.assert(targetProduct !== undefined, "부하테스트용 타겟 상품 문서가 유실됨.");

        client.log("몽고DB 초기 적재 수량: " + targetProduct.options[0].currentDailyStock + "개 확인.");
        client.log("동일 요청을 한 번 더 클릭하여 Redis 캐시에서 1ms 만에 Hit 되는지 검증 후 다음 테스트 진행하기");
    });
%}


### 003 [오더 연동 및 카프카 무효화 트리거] 장바구니에 중복 옵션을 담아 주문 발생
POST http://{{host}}:{{gatewayPort}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{cat_user_token}}

{
    "reservationId": "c4d17b16-c127-4efe-9599-73470904b936",
    "restaurantId": "85c4b84f-f7f2-46cc-9dfc-4fc6dc805084",
    "orderName": "레디스 무효화 검증 연동 주문",
    "receivingMethod": "PICKUP",
    "expiredAt": "2026-12-31T23:59:59",
    "items": [
        {
            "optionId": "44444444-4444-4444-4444-444444444444",
            "quantity": 2
        },
        {
            "optionId": "44444444-4444-4444-4444-444444444444",
            "quantity": 3
        }
    ]
}

> {%
    client.test("오더 연동 성공 및 롤백 보상 트랜잭션 정상 예약 완료", function () {
        client.assert(response.status === 201, "오더 서비스 연동 장애 발생");
        client.log("묶음 주문 전송 성공! 내부 스케줄러가 카프카로 '수량 5개 합산 차감'을 던짐.");
        client.log("카탈로그 Consumer 서버창에 '[Kafka] stock.reserved 이벤트 수신 및 캐시 무효화 트리거' 문구가 뜨면 바로 다음 테스트 진행.");
    });
%}


### 004. [최종 변동 조회 및 정합성 매칭] 캐시가 무효화되어 최신 정보로 강제 갱신되었는지 검증
# 만약 캐시가 정상적으로 날아갔다면(Evicted) 다시 한번 "[Cache Miss] ..." 콘솔 로그가 새롭게 찍히고,
# 유저에게 최종적으로 반환되는 실시간 일일 재고 수량은 '999,995'개로 동기화되어 내려오게 됨
GET http://{{host}}:{{gatewayPort}}/api/v1/products?page=0&size=10
Accept: application/json
Authorization: Bearer {{cat_user_token}}

> {%
    client.test("대망의 Redis 데이터 무효화 및 최종 정합성 마스터 매칭 검증", function () {
        client.assert(response.status === 200, "최종 결과 수신 실패");

        var content = response.body.content;
        var targetProduct = content.find(p => p.name === "타겟 부하테스트 상품");
        var latestStock = targetProduct.options[0].currentDailyStock;

        client.log("현재 Redis 및 몽고DB 스냅샷에 마킹된 실시간 잔여 일일 재고: " + latestStock);

        // 정합성 매치 가드: 100만 개에서 정확히 5개가 빠진 999995여야 성공함
        client.assert(latestStock === 999995, "[FAIL] 캐시 무효화 연산 실패. 아직 레디스에 과거 데이터 1,000,000개가 그대로 존재함.");

        client.log("[SUCCESS] 성공! Cache-Aside 적중 부하 분산과 Kafka 이벤트 기반 실시간 캐시 폭파 정합성 연동이 100% 무결하게 증명됨");
    });
%}
